# Required: OpenAI-compatible LLM
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
CONSOLE_MODEL=gpt-4o-mini
SANDBOX_MODEL=

# Required: Feishu app (ADR-008)
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_DOMAIN=https://open.feishu.cn
# @ 门控：@ 才进问答管线，其余群消息旁听落库
FEISHU_REQUIRE_MENTION=true
FEISHU_ALLOWED_USERS=*
# 群白名单（硬门控，同时约束旁听范围），逗号分隔
FEISHU_ALLOWED_CHATS=
# 机器人身份（mentions 结构化 @ 判定用；开放平台「凭证与基础信息」页可查）
FEISHU_BOT_OPEN_ID=
FEISHU_BOT_USER_ID=
# 历史回拉：单群回拉时间窗（天）与条数上限；旁听消息保留期（天）
FEISHU_BACKFILL_DAYS=7
FEISHU_BACKFILL_MAX=1000
FEISHU_OBSERVE_RETAIN_DAYS=30

# Optional: data storage
MEMORY_DB_URL=sqlite+aiosqlite:///./data/opendomino.db
CHROMA_PERSIST_DIR=./data/chroma

# Optional: Langfuse (disabled until credentials are configured)
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=http://localhost:3000

# Optional: Embedding for KBase vector recall (ADR-002 Phase C)
# Volces Ark inference endpoint ID (ep-xxx) created from the console for
# doubao-embedding-large-text-250515. Leave empty to disable vector recall.
EMBEDDING_MODEL=
EMBEDDING_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
EMBEDDING_API_KEY=
EMBEDDING_DIM=2048

GITHUB_TOKEN=