# Required: OpenAI-compatible LLM
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
CONSOLE_MODEL=gpt-4o-mini

# Required: DingTalk Stream robot
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=
DINGTALK_REQUIRE_MENTION=true
DINGTALK_ALLOWED_USERS=*
DINGTALK_FREE_RESPONSE_CHATS=
DINGTALK_ALLOWED_CHATS=

# Optional: data storage
MEMORY_DB_URL=sqlite+aiosqlite:///./data/opendomino.db
CHROMA_PERSIST_DIR=./data/chroma

# Optional: Langfuse (disabled until credentials are configured)
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=http://localhost:3000

# Optional: Embedding for KBase vector recall (ADR-002 Phase C)
# Volces Ark inference endpoint ID (ep-xxx) created from the console for
# doubao-embedding-large-text-250515. Leave empty to disable vector recall.
EMBEDDING_MODEL=
EMBEDDING_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
EMBEDDING_API_KEY=
EMBEDDING_DIM=2048
